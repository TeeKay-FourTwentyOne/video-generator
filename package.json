{
  "name": "video-pipeline",
  "version": "1.0.0",
  "description": "AI video production pipeline using MCP (Model Context Protocol)",
  "type": "module",
  "scripts": {
    "build": "cd mcp/video-generator && npm run build",
    "start": "cd mcp/video-generator && npm run dev",
    "mcp": "cd mcp/video-generator && node dist/server.js",
    "scene:studio": "node tools/scene-lab/server.mjs",
    "scene:capture": "node tools/scene-lab/capture.mjs",
    "scene:test": "node --test tools/scene-lab/*.test.mjs",
    "privacy:install": "node tools/privacy-check.mjs --install-hooks",
    "privacy:worktree": "node tools/privacy-check.mjs --worktree",
    "privacy:check": "node tools/privacy-check.mjs --staged",
    "privacy:outgoing": "node tools/privacy-check.mjs --outgoing",
    "privacy:test": "node --test tools/privacy-check.test.mjs",
    "film": "node tools/production/film.mjs",
    "test": "npm run build && node --test tools/production/*.test.mjs",
    "test:local": "npm test && npm run scene:test && npm run privacy:test"
  },
  "keywords": [
    "mcp",
    "video",
    "ai",
    "veo",
    "claude"
  ],
  "license": "MIT"
}
